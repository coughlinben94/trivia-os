{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "ToolSearch",
      "Skill",
      "Bash(./concepts/tools/*)",
      "Bash(git *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(echo *)",
      "Bash(rm *)",
      "Bash(cat *)",
      "Bash(mv *)",
      "Bash(gh *)",
      "Bash(cd /Users/bencoughlin/Projects/baynes-trivia/trivia-os && git *)",
      "Bash(cd /Users/bencoughlin/Projects/baynes-trivia/trivia-os && node *)",
      "Bash(cd /Users/bencoughlin/Projects/baynes-trivia/trivia-os && npm *)",
      "Bash(cd /Users/bencoughlin/Projects/baynes-trivia/trivia-os && echo *)",
      "Bash(cd /Users/bencoughlin/Projects/baynes-trivia/trivia-os && rm *)",
      "Bash(cd /Users/bencoughlin/Projects/baynes-trivia/trivia-os && cat *)",
      "Bash(cd /Users/bencoughlin/Projects/baynes-trivia/trivia-os && mv *)",
      "Bash(cd /Users/bencoughlin/Projects/baynes-trivia/trivia-os && gh *)",
      "Bash(cd /Users/bencoughlin/Projects/baynes-trivia/trivia-os && ./concepts/tools/*)",
      "mcp__cowork__allow_cowork_file_delete",
      "mcp__github__create_pull_request",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__performance_start_trace",
      "mcp__chrome-devtools__performance_stop_trace",
      "mcp__chrome-devtools__performance_analyze_insight",
      "SlashCommand(/preflight)",
      "SlashCommand(/claim)",
      "SlashCommand(/audit)",
      "SlashCommand(/ship)"
    ],
    "deny": [
      "Write(concepts/.design-critic-verdicts/**)",
      "Edit(concepts/.design-critic-verdicts/**)",
      "Write(concepts/.design-attempt-counts.json)",
      "Edit(concepts/.design-attempt-counts.json)",
      "Write(concepts/design-cases.json)",
      "Edit(concepts/design-cases.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/protect-json-stores.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/geometry-lint.mjs --hook" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/design-done-gate.mjs" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/design-done-gate.mjs" }
        ]
      }
    ]
  }
}
