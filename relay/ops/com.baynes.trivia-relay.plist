<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iPad remote relay (spec §11). Never sets RELAY_DEV.
     Install: cp relay/ops/com.baynes.trivia-relay.plist ~/Library/LaunchAgents/
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.baynes.trivia-relay.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.baynes.trivia-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/bencoughlin/Projects/baynes-trivia/trivia-os/relay/server.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/bencoughlin/Projects/baynes-trivia/trivia-os/relay</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/bencoughlin/Library/Logs/trivia-relay.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bencoughlin/Library/Logs/trivia-relay.log</string>
</dict>
</plist>
