  "description": "Real-time trivia night management system for Baynes Apple Valley",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ship": "bash scripts/ship.sh",
    "test:unit": "vitest run",
    "backup": "node scripts/backup-db.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test e2e/host-smoke.spec.js",
    "test:e2e:join": "playwright test e2e/join-smoke.spec.js",
    "test:audit": "playwright test e2e/host-audit.spec.js",
    "test:wizard": "playwright test e2e/wizard-audit.spec.js",
    "// test:wizard-create": "OPT-IN \u2014 creates slides in the show it targets, so it needs a THROWAWAY show id and skips cleanly without one. The anon-key/RLS cleanup defect is fixed (e2e/authed-client.js). Run: ALLOW_WIZARD_CREATE=1 PLAYWRIGHT_SHOW_ID=<throwaway> npm run test:wizard-create",
    "test:wizard-create": "playwright test e2e/wizard-create-verify.spec.js",
    "verify:ring": "node concepts/tools/ring-verify.mjs concepts/world-07-ring.html"
  },
